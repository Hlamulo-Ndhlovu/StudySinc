# Copy this file to:  keystore.properties  (project root, next to settings.gradle)
# Never commit keystore.properties — it is in .gitignore.
#
# RULES
# - No quotes around values. No spaces before/after =.
# - Use the keystore whose SHA-1 matches Google Play verification (keytool -list -v).
# - storeFile: relative to project root OR absolute with forward slashes, e.g.:
#     signing/my-release.jks
#     C:/Users/you/Documents/studysync-release.jks
#
# If passwords fail with BadPaddingException: wrong password or wrong file — fix before build.
#
# Optional: omit storePassword/keyPassword here and set env instead (PowerShell):
#   $env:STUDYSYNC_STORE_PASSWORD = '...'
#   $env:STUDYSYNC_KEY_PASSWORD = '...'   # if different from store password
#   .\gradlew bundleRelease

storeFile=
storePassword=
keyAlias=
keyPassword=
