    <string name="settings_community_standards_title">Amazinga omphakathi</string>
    <string name="settings_community_standards_body">I-StudySync yenzelwe ukufunda nokusebenza ndawonye. Ungabelani, ungaceli, noma ungabheki ubunqunu, izithombe noma ividiyo yocansi, noma okuqukethwe okunye kwezocansi emilayezweni, emafayeleni, ezingcingweni zevidiyo, noma kuphrofayela yakho. Singasusa okuqukethwe futhi simise ama-akhawunti ephula le mithetho.</string>
    <string name="classes_hero_subtitle">Hlela izikhathi, uqale ukusakaza, ugcine amanothi nezinsiza endaweni eyodwa.</string>
    <string name="classes_hint_has_items">Vula ikilasi ukuze uthole imininingwane, ividiyo ebukhoma, namafayela abiwe. Ungalishintsha esikrinini semininingwane.</string>
    <string name="classes_hint_empty">Dala ikilasi ngo-+ ukuze wengeze imihlangano, izixhumanisi, nemibhalo.</string>
    <string name="dashboard_empty_activity">Awukabikho umsebenzi wakamuva. Vula iqembu ukuze wabelane ngamafayela uxoxe, noma uqale ikilasi lemihlangano ebukhoma.</string>
    <string name="chats_hero_subtitle">Thumela imilayezo emaqenjini akho ulandele izibuyekezo ezabiwe.</string>
    <string name="groups_hero_title">Amaqembu</string>
    <string name="groups_hero_subtitle">Dala indawo yokuxoxa nokwabelana ngemibhalo — bese uvula Imilayezo ukuze ukhulume.</string>
    <string name="groups_dialog_new_title">Iqembu elisha</string>
    <string name="groups_empty_hint">Awekho amaqembu okwamanje. Thepha u-+ ukudala indawo yamafayela nengxoxo.</string>
    <string name="profile_default_display_name">Ilungu le-StudySync</string>
    <string name="profile_account_id_label">I-ID ye-akhawunti: %1$s</string>
    <string name="profile_default_bio">Ngilapha ukwabelana ngamafayela, ukuhlangana ku-inthanethi, nokuhlala ngixhumene namaqembu ami.</string>
    <string name="profile_sample_post_body">Yabelana ngezibuyekezo, amafayela, namanothi emihlangano namaqembu akho. Izici eziningi ziyeza.</string>

    <string name="privacy_policy">Inqubomgomo yobumfihlo</string>
    <string name="settings_report_safety_title">Bika inkinga yokuphepha</string>
    <string name="settings_report_safety_cta">Bhala i-imeyili</string>
    <string name="settings_report_safety_subtitle">Sithumelele i-imeyili mayelana nokuhlukunyezwa, okuqukethwe okungafanele, noma okunye ukwephula. Yisho okwenzekile nalapho (isibonelo igama leqembu noma lekilasi).</string>
    <string name="settings_report_email_body">Chaza okwenzekile nalapho ukubonile khona (iqembu, ikilasi, ingxoxo, noma iphrofayela). Sizobuyekeza ngokushesha.\n\n(Uhlelo lwakho lweposi lungafaka ikheli lakho ngokuzenzakalelayo.)</string>
    <string name="settings_report_no_email_app">Alukho uhlelo lwe-imeyili. Thumela umlayezo ekhelini elikhonjiswe kuNqubomgomo yobumfihlo.</string>

